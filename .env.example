# ComfyUI-3D-Pack Configuration
# Copy this file to .env and fill in your values

# HuggingFace Authentication
HUGGINGFACE_TOKEN=

# API Security
API_KEYS=your-secret-api-key-here,another-key-here
ALLOWED_ORIGINS=http://localhost:8188,https://yourdomain.com

# Web Server Configuration
ALLOWED_IPS=127.0.0.1,0.0.0.0,172.17.0.0,172.17.0.1

# Model Storage
MODELS_BASE_PATH=/app/models
OUTPUT_BASE_PATH=/app/output

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Performance
MAX_WORKERS=4
GPU_MEMORY_FRACTION=0.8
REQUEST_TIMEOUT=3600

# Security
ENABLE_AUTH=true
CORS_ENABLED=true
