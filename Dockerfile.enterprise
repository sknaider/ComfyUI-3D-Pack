# Enterprise-grade Dockerfile with multi-stage build, health checks, and security
# Build arguments for flexibility
ARG CUDA_VERSION=12.4.0-devel
ARG PYTHON_VERSION=3.11
ARG COMFYUI_COMMIT=29c2e26724d4982a3e33114eb9064f1a11f4f4ed

# =============================================================================
# Stage 1: Base image with system dependencies
# =============================================================================
FROM --platform=amd64 docker.io/nvidia/cuda:${CUDA_VERSION}-ubuntu22.04 AS base

# Metadata labels
LABEL maintainer="ComfyUI-3D-Pack Contributors"
LABEL description="Enterprise-grade ComfyUI-3D-Pack with GPU support"
LABEL version="0.1.6"
LABEL org.opencontainers.image.source="https://github.com/MrForExample/ComfyUI-3D-Pack"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install system dependencies in a single layer
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        build-essential \
        curl \
        ca-certificates \
        ffmpeg \
        git \
        # Graphics libraries
        libegl1 \
        libegl1-mesa-dev \
        libgl1 \
        libgl1-mesa-dev \
        libgl1-mesa-glx \
        libgles2 \
        libgles2-mesa-dev \
        libglib2.0-0 \
        libglvnd-dev \
        libglvnd0 \
        libglx0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        # Build tools
        ninja-build \
        # Python
        python${PYTHON_VERSION} \
        python${PYTHON_VERSION}-dev \
        python${PYTHON_VERSION}-venv \
        wget \
        && \
    # Install pip
    curl -sS https://bootstrap.pypa.io/get-pip.py | python${PYTHON_VERSION} && \
    # Clean up
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create symbolic links for python
RUN ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python && \
    ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python3 && \
    ln -sf /usr/bin/pip${PYTHON_VERSION} /usr/bin/pip

# Upgrade pip
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Create non-root user for security
RUN adduser --uid 1001 --disabled-password --gecos "" user && \
    mkdir -p /app /app/models /app/output && \
    chown -R user:user /app

# =============================================================================
# Stage 2: Python dependencies builder
# =============================================================================
FROM base AS builder

USER user
WORKDIR /app

# Create virtual environment
RUN python -m venv /app/venv

# Activate virtual environment
ENV PATH="/app/venv/bin:$PATH" \
    VIRTUAL_ENV="/app/venv" \
    PYTHONPATH="/app/venv/lib/python${PYTHON_VERSION}/site-packages" \
    PYTHONUSERBASE="/app/venv"

# Clone ComfyUI repository
ARG COMFYUI_COMMIT
RUN git clone "https://github.com/comfyanonymous/ComfyUI.git" /app && \
    cd /app && \
    git reset --hard ${COMFYUI_COMMIT}

# Install ComfyUI requirements
COPY --chown=user:user requirements.txt /tmp/3dpack-requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt && \
    pip install --no-cache-dir -r /tmp/3dpack-requirements.txt && \
    pip install --no-cache-dir ninja rembg[gpu] open_clip_torch

# =============================================================================
# Stage 3: Final runtime image
# =============================================================================
FROM base AS runtime

USER user
WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder --chown=user:user /app/venv /app/venv
COPY --from=builder --chown=user:user /app /app

# Environment variables
ENV PATH="/app/venv/bin:$PATH" \
    VIRTUAL_ENV="/app/venv" \
    PYTHONPATH="/app/venv/lib/python3.11/site-packages" \
    PYTHONUSERBASE="/app/venv" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # GLEW
    LD_LIBRARY_PATH=/usr/lib64:$LD_LIBRARY_PATH \
    # NVIDIA
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics \
    # PyOpenGL
    PYOPENGL_PLATFORM=egl \
    # Application
    APP_ENV=production \
    LOG_LEVEL=INFO \
    LOG_FORMAT=json

# Install ComfyUI-3D-Pack
WORKDIR /app/custom_nodes/ComfyUI-3D-Pack/
COPY --chown=user:user . ./
RUN pip install --no-cache-dir -e .

# Install essential custom nodes
WORKDIR /app/custom_nodes/

# ComfyUI-Impact-Pack
RUN git clone "https://github.com/ltdrdata/ComfyUI-Impact-Pack" && \
    cd ComfyUI-Impact-Pack && \
    git reset --hard ab17f8886945b0d36478950fe532164a8b569cc7 && \
    pip install --no-cache-dir -r requirements.txt

# ComfyUI-KJNodes
RUN git clone "https://github.com/kijai/ComfyUI-KJNodes" && \
    cd ComfyUI-KJNodes && \
    git reset --hard ffafc9c2c675ce4e89386c725def331a88274004 && \
    pip install --no-cache-dir -r requirements.txt

# ComfyUI-VideoHelperSuite
RUN git clone "https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite" && \
    cd ComfyUI-VideoHelperSuite && \
    git reset --hard 70faa9bcef65932ab72e7404d6373fb300013a2e && \
    pip install --no-cache-dir -r requirements.txt

# ComfyUI-Manager
RUN git clone "https://github.com/ltdrdata/ComfyUI-Manager.git" && \
    cd ComfyUI-Manager && \
    git reset --hard 2b8e76197ae970dbd7854a09a5ef57731dc1c82f

# Create required directories
RUN mkdir -p /app/models /app/output /app/temp && \
    chown -R user:user /app/models /app/output /app/temp

# Expose port
EXPOSE 8188

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8188/health || exit 1

# Volume mounts for persistence
VOLUME ["/app/models", "/app/output"]

# Switch back to app directory
WORKDIR /app

# Entrypoint with health monitoring
ENTRYPOINT ["python", "main.py", "--listen", "0.0.0.0"]

# Default command can be overridden
CMD []
